# App configuration
APP_NAME=RAG Document Chatbot API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FILE=backend/logs/app.log

# Backend security and limits
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_FILES=10
MAX_PDF_SIZE_MB=25
RETRIEVAL_TOP_K=3

# AI services
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-120b
TEMPERATURE=0.2
TOP_P=0.9
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage paths
UPLOAD_DIR=backend/uploads
FAISS_INDEX_PATH=backend/faiss_index